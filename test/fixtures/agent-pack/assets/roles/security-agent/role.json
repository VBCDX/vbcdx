{
  "schema_version": 1,
  "id": "security-agent",
  "credential_suffix": "SECURITY_AGENT",
  "name": "Security Agent",
  "description": "Audits a repository for security problems and reports findings.",
  "policy": {
    "kind": "inspector",
    "summary": "Inspects source and reports findings; does not modify source or merge. Its unrestricted shell means source read-only is an advisory policy, not a harness-enforced control.",
    "source_read_only": true,
    "may_merge": false,
    "enforcement": "Local file and shell access is granted by native harness tool permissions; remote reads and writes are governed by the service write-mode and the token's own scopes. Source-read-only and merge stances are advisory unless a native control or credential scope actually enforces them."
  },
  "local_capabilities": {
    "filesystem": "read-only",
    "shell": true,
    "web": true,
    "delegation": false
  },
  "web_search": true,
  "remote_capabilities": {
    "forgejo": [
      "whoami",
      "list_repositories",
      "get_repository",
      "list_branches",
      "get_file",
      "list_issues",
      "get_issue",
      "list_comments",
      "get_comment",
      "list_labels",
      "list_milestones",
      "list_pull_requests",
      "get_pull_request",
      "list_pull_request_files",
      "get_pull_request_diff",
      "list_reviews",
      "get_review",
      "list_commit_statuses",
      "list_workflow_runs",
      "get_workflow_run",
      "list_workflow_jobs",
      "create_issue",
      "create_comment",
      "update_comment",
      "create_review"
    ],
    "coolify": [
      "health",
      "version",
      "list_applications",
      "get_application",
      "get_application_logs",
      "list_application_envs",
      "list_databases",
      "get_database",
      "list_services",
      "get_service",
      "list_projects",
      "get_project",
      "list_servers",
      "get_server",
      "list_resources",
      "list_deployments",
      "get_deployment"
    ]
  },
  "dependencies": {
    "forgejo": "vbcdx.forgejo/1",
    "coolify": "vbcdx.coolify/1"
  },
  "opencode_mode": "all"
}
