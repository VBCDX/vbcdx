{
  "$schema": "../../../schema/vbcdx-tool.schema.json",
  "schema_version": 1,
  "server_name": "example-tracker",
  "contract": "example.tracker/1",
  "stdio": { "bin": "example-tracker", "args": ["mcp"] },
  "http": { "args": ["serve"], "path": "/mcp", "port_env": "EXAMPLE_TRACKER_HTTP_PORT" },
  "env": [
    { "name": "EXAMPLE_TRACKER_URL", "description": "Origin of the tracker instance the tools call.", "kind": "config", "required": true },
    { "name": "EXAMPLE_TRACKER_WRITES", "description": "off, write or full; off by default.", "kind": "config", "required": false },
    { "name": "EXAMPLE_TRACKER_TOKEN", "description": "API token for the tracker; never written inline.", "kind": "credential", "required": false },
    { "name": "EXAMPLE_TRACKER_HTTP_PORT", "description": "Listen port for serve mode.", "kind": "config", "required": false, "modes": ["http"] }
  ],
  "credential_file": { "argument": "credential_file" },
  "manifest": { "args": ["manifest"] }
}
